# Copier en .env et renseigner les valeurs réelles. Ne jamais committer .env.

DATABASE_URL=postgresql+psycopg2://user:password@host:5432/tip_db
DATABASE_URL_LOCAL=postgresql+psycopg2://tip:tip_secret@localhost:5433/tip_db

ABUSECH_AUTH_KEY=
OTX_API_KEY=
NVD_API_KEY=
TIP_API_KEY=
JWT_SECRET_KEY=
TOKEN=
SHODAN_API_KEY=
NEON_API_KEY=

# Digest email IOC Cameroun (scripts/send_email_digest.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Seuil minimal de cameroon_relevance pour qu'un IOC soit inclus dans le digest
EMAIL_DIGEST_MIN_RELEVANCE=3
# Nombre max d'IOCs dans un digest (les plus récents en priorité, first_seen DESC)
EMAIL_DIGEST_MAX_IOCS=30
